# Ejemplo de nombres de variables. Nunca guardar credenciales reales en Git.
# El proveedor configura PORT automáticamente; para Docker local usa 8501.
PORT=8501

# Opcional: usa una ruta montada para que GeoTIFF e historial sobrevivan a redeploys.
# En Render/Railway con disco persistente en /app/storage:
# VISOR_DATA_DIR=/app/storage/data

# Opcional: mapa de CARTO. Configurar en Secrets del proveedor, nunca aquí.
# CARTO_API_KEY=

# No definir tokens EARTHDATA ni contraseñas en este archivo.
