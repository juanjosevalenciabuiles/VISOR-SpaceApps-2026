# V.I.S.O.R. | Despliegue NASA — base funcional 3f67ecb
# Solo afecta a la imagen publicada. NO borra archivos del workspace.
#
# Metadatos de desarrollo (4.9 GiB): no necesarios para ejecutar Streamlit.
.git/
# Instalacion duplicada de paquetes (767 MiB): start.sh usa exclusivamente .venv.
.pythonlibs/
# Archivos temporales del editor y las pruebas.
.cache/
.pytest_cache/
__pycache__/
*.pyc
tests/
informes/
exportaciones/
# Secretos en Replit Deployment Secrets, nunca en la imagen.
.env
.env.*
.streamlit/secrets.toml

# Datos de trabajos anteriores: pueden apuntar a archivos que no existen en
# produccion. Los nuevos se crean durante el procesamiento en data/trabajos/.
data/trabajos/

# Harmony: preservar originales solo en el workspace, evitar que 65 caches
# historicos (~5.9 GiB) se empaqueten. El proceso ya crea/descarga COG nuevos
# cuando un AOI/fecha carece de cache compatible.
data/nisar/harmony/**

# Conservar UNA pareja pequena de preparaciones del AOI de Chigorodo
# (2026-10-24 y 2026-11-05; ~78 MiB cada una) para demostracion.
# Debe verificarse el manifest/CRS/huella antes de afirmar que es reutilizable.
!data/nisar/harmony/375d3135cd519661/
!data/nisar/harmony/375d3135cd519661/**
!data/nisar/harmony/3875345486d3a7c7/
!data/nisar/harmony/3875345486d3a7c7/**

# Conservar data/analisis/: contiene resultados GeoTIFF mostrados en el mapa.
# Conservar .venv/: start.sh lo verifica y reutiliza al publicar.
