modules = ["python-3.12", "web"]
run = "bash start.sh"

[nix]
channel = "stable-25_05"
# Expat queda declarada en el entorno: Rasterio la necesita (libexpat.so.1).
# start.sh localiza la versión compatible sin depender de una ruta fija.
packages = ["expat"]

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
# Mismo arranque que en desarrollo, para que el despliegue tenga las mismas bibliotecas.
run = ["bash", "start.sh"]
