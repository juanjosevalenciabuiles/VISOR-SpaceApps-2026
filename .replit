modules = ["python-3.12", "web"]
run = "bash start.sh"

[nix]
channel = "stable-25_05"
packages = ["expat"]

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
# Mismo arranque que en desarrollo, para que el despliegue tenga las mismas bibliotecas.
build = ["bash", "start.sh", "--verificar"]
run = ["bash", "start.sh"]
