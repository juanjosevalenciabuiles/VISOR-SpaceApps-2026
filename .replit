modules = ["python-3.12", "web"]
run = "bash start.sh"

[nix]
channel = "stable-25_05"
packages = ["expat"]

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
# Dependencias instaladas en build y vendorizadas fuera de .venv.
# Autoscale no tiene que resolver PyPI ni crear entornos al iniciar.
# El boton Run del workspace sigue usando el start.sh original.
build = ["bash", "deploy/build.sh"]
run = ["bash", "deploy/run.sh"]
